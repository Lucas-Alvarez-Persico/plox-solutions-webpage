# Datos de acceso FTP para `npm run deploy`. Copiá este archivo como
# `.env.deploy` (no se commitea) y completalo con lo que muestra el panel de
# DonWeb, en Mis Sitios → Acceso por FTP.

FTP_HOST=a0160911.ferozo.com
FTP_USER=a0160911
# La contraseña no se ve en el panel: si no la sabés, cambiala ahí mismo con
# "Cambiar contraseña" y pegala acá.
FTP_PASSWORD=

# Opcionales (estos son los valores por defecto):
# FTP_PORT=21
# FTP_DIR=public_html
# FTPS: el servidor tiene certificado válido para *.ferozo.com.
# FTP_SECURE=true
